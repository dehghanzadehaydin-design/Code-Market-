<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>کدمارکت پرو | فروشگاه سورس کد و کامپوننت</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Vazirmatn:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-page: #f1f5f9;
            --bg-card: #ffffff;
            --bg-soft: #f8fafc;
            --border-color: #e2e8f0;
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --emerald: #059669;
            --emerald-light: #ecfdf5;
            --amber: #d97706;
            --amber-light: #fffbeb;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Vazirmatn', Tahoma, sans-serif;
            max-width: 100%;
        }

        html, body {
            width: 100%;
            overflow-x: hidden;
            background-color: var(--bg-page);
            color: var(--text-dark);
            line-height: 1.6;
        }

        .container {
            width: 100%;
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .hidden { display: none !important; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }

        /* نوار تبلیغاتی بالا */
        .promo-banner {
            background: linear-gradient(90deg, #1e40af, #2563eb, #0284c7);
            color: #ffffff;
            padding: 8px 12px;
            font-size: 11.5px;
        }
        .promo-inner {
            max-width: 1140px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .promo-code {
            background: rgba(255,255,255,0.22);
            padding: 1px 6px;
            border-radius: 5px;
            font-weight: 800;
        }
        .btn-promo-copy {
            background: #ffffff;
            color: #1e3a8a;
            border: none;
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            white-space: nowrap;
        }

        /* هدر */
        header {
            position: sticky;
            top: 0;
            z-index: 40;
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-color);
            padding: 10px 0;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04);
        }
        .header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 10px;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        .brand-logo {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            background: linear-gradient(135deg, #2563eb, #059669);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 900;
            font-size: 15px;
            flex-shrink: 0;
        }
        .brand-title {
            font-size: 16px;
            font-weight: 900;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .pro-tag {
            font-size: 10px;
            background: #dbeafe;
            color: #1d4ed8;
            padding: 1px 6px;
            border-radius: 6px;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-header {
            background: var(--bg-soft);
            border: 1px solid var(--border-color);
            color: var(--text-dark);
            padding: 6px 10px;
            border-radius: 10px;
            font-size: 11.5px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
            white-space: nowrap;
        }
        .badge-count {
            background: var(--emerald);
            color: #fff;
            font-weight: 800;
            font-size: 10.5px;
            padding: 1px 6px;
            border-radius: 99px;
        }

        .search-box {
            width: 100%;
            position: relative;
        }
        .search-input {
            width: 100%;
            background: var(--bg-soft);
            border: 1px solid var(--border-color);
            color: var(--text-dark);
            padding: 9px 14px 9px 32px;
            border-radius: 12px;
            font-size: 12.5px;
            outline: none;
        }
        .search-input:focus {
            border-color: var(--primary);
            background: #fff;
        }
        .clear-btn {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 14px;
        }

        /* بخش Hero و کارت بانکی سامان */
        .hero-section {
            padding: 18px 0;
        }
        .hero-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
        }
        @media (min-width: 860px) {
            .hero-grid {
                grid-template-columns: 1.2fr 1fr;
                align-items: center;
            }
        }
        .hero-box {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 18px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
        }
        .hero-pill {
            display: inline-block;
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 4px 12px;
            border-radius: 99px;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .hero-title {
            font-size: 20px;
            font-weight: 900;
            line-height: 1.4;
            margin-bottom: 8px;
            color: #0f172a;
        }
        .hero-desc {
            color: var(--text-muted);
            font-size: 12.5px;
            margin-bottom: 14px;
        }
        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .stat-box {
            background: var(--bg-soft);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 10px 6px;
            text-align: center;
        }
        .stat-num {
            font-size: 15px;
            font-weight: 900;
            color: var(--primary);
        }
        .stat-lbl {
            font-size: 10.5px;
            color: var(--text-muted);
        }

        /* کارت بانکی سامان ایران (روشن و خوش‌استایل در موبایل) */
        .saman-card {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 55%, #1e3a8a 100%);
            border-radius: 20px;
            padding: 18px;
            color: #ffffff;
            box-shadow: 0 12px 28px rgba(2, 132, 199, 0.28);
        }
        .saman-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }
        .saman-logo-box {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .saman-emblem {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 16px;
        }
        .status-live {
            background: rgba(16, 185, 129, 0.25);
            border: 1px solid rgba(167, 243, 208, 0.5);
            color: #ecfdf5;
            font-size: 10.5px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 99px;
        }
        .card-number-bar {
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 12px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 12px;
        }
        .card-digits {
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.8px;
            color: #ffffff;
            white-space: nowrap;
        }
        .btn-copy-card {
            background: #ffffff;
            color: #0369a1;
            border: none;
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .saman-card-bottom {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #e0f2fe;
        }

        /* نوار فیلترها */
        .filters-bar {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 12px;
            margin-bottom: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .filter-group {
            display: flex;
            align-items: center;
            gap: 6px;
            overflow-x: auto;
            padding-bottom: 2px;
        }
        .filter-group::-webkit-scrollbar { display: none; }

        .chip-btn {
            background: var(--bg-soft);
            border: 1px solid var(--border-color);
            color: var(--text-dark);
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 11.5px;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
            flex-shrink: 0;
        }
        .chip-btn.active {
            background: var(--primary);
            border-color: var(--primary);
            color: #ffffff;
        }
        .lang-btn {
            background: #f1f5f9;
            border: 1px solid transparent;
            color: #475569;
            padding: 5px 11px;
            border-radius: 9px;
            font-size: 11.5px;
            font-weight: 700;
            white-space: nowrap;
            cursor: pointer;
            flex-shrink: 0;
        }
        .lang-btn.active {
            background: #0f172a;
            color: #ffffff;
        }

        .results-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11.5px;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        /* گرید کارت‌های کد */
        .snippets-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }
        @media (min-width: 680px) {
            .snippets-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (min-width: 1024px) {
            .snippets-grid { grid-template-columns: repeat(3, 1fr); }
        }

        .code-card {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 18px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 12px;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            transition: transform 0.15s, box-shadow 0.15s;
        }
        .code-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
        }
        .card-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .lang-pill {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 2px 9px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
        }
        .price-pill-free {
            background: var(--emerald-light);
            color: var(--emerald);
            border: 1px solid #a7f3d0;
            padding: 2px 10px;
            border-radius: 99px;
            font-size: 11px;
            font-weight: 800;
        }
        .price-pill-paid {
            background: var(--amber-light);
            color: var(--amber);
            border: 1px solid #fde68a;
            padding: 2px 10px;
            border-radius: 99px;
            font-size: 11px;
            font-weight: 800;
        }
        .price-pill-owned {
            background: #ecfeff;
            color: #0e7490;
            border: 1px solid #a5f3fc;
            padding: 2px 10px;
            border-radius: 99px;
            font-size: 11px;
            font-weight: 800;
        }
        .card-title {
            font-size: 14.5px;
            font-weight: 800;
            color: #0f172a;
            margin-top: 8px;
        }
        .card-desc {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .code-preview-box {
            position: relative;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px;
            margin-top: 10px;
            overflow: hidden;
            min-height: 76px;
        }
        .code-preview-box pre {
            font-size: 11px;
            color: #334155;
            overflow-x: auto;
            margin: 0;
        }
        .blurred {
            filter: blur(4px);
            user-select: none;
        }
        .lock-overlay {
            position: absolute;
            inset: 0;
            background: rgba(248, 250, 252, 0.72);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .lock-badge {
            background: #ffffff;
            border: 1px solid #fde68a;
            color: #b45309;
            padding: 5px 11px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 800;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .card-footer {
            border-top: 1px solid var(--border-color);
            padding-top: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .dl-count {
            font-size: 11px;
            color: var(--text-muted);
        }
        .btn-action-free {
            background: var(--emerald);
            color: #ffffff;
            border: none;
            padding: 7px 14px;
            border-radius: 10px;
            font-size: 11.5px;
            font-weight: 800;
            cursor: pointer;
        }
        .btn-action-buy {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 7px 14px;
            border-radius: 10px;
            font-size: 11.5px;
            font-weight: 800;
            cursor: pointer;
        }

        /* باکس تبلیغات همسان */
        .native-ad-box {
            margin-top: 22px;
            background: #ffffff;
            border: 1px solid #bfdbfe;
            border-radius: 18px;
            padding: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }
        .ad-tag {
            font-size: 10px;
            background: #eff6ff;
            color: #2563eb;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 4px;
        }
        .btn-ad-cta {
            background: #0f172a;
            color: #ffffff;
            border: none;
            padding: 9px 16px;
            border-radius: 10px;
            font-size: 11.5px;
            font-weight: 800;
            cursor: pointer;
        }

        /* مودال‌ها */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 60;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 12px;
            overflow-y: auto;
        }
        .modal-box {
            background: #ffffff;
            color: #0f172a;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            width: 100%;
            max-width: 620px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.25);
        }
        .modal-header {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            position: sticky;
            top: 0;
            background: #ffffff;
            z-index: 5;
        }
        .modal-body {
            padding: 16px;
        }
        .btn-close-modal {
            background: #f1f5f9;
            border: none;
            color: #334155;
            width: 32px;
            height: 32px;
            border-radius: 9px;
            cursor: pointer;
            font-weight: 800;
            flex-shrink: 0;
        }

        /* درگاه پرداخت سامان */
        .gateway-box {
            background: #ffffff;
            color: #0f172a;
            border-radius: 22px;
            width: 100%;
            max-width: 480px;
            max-height: 92vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.35);
        }
        .gateway-header {
            background: linear-gradient(90deg, #0284c7, #1e3a8a);
            color: #fff;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .gateway-timer {
            background: rgba(0,0,0,0.3);
            color: #fde047;
            padding: 3px 9px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 12px;
        }
        .gw-form-group { margin-bottom: 12px; }
        .gw-label {
            display: block;
            font-size: 11.5px;
            font-weight: 700;
            color: #334155;
            margin-bottom: 5px;
        }
        .gw-input {
            width: 100%;
            background: #f8fafc;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            padding: 9px 10px;
            font-size: 13.5px;
            color: #0f172a;
            outline: none;
            text-align: center;
        }
        .gw-input:focus {
            border-color: #0284c7;
            background: #fff;
        }
        .gw-row-2 {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
        }
        @media (min-width: 460px) {
            .gw-row-2 { grid-template-columns: 1fr 1fr; }
        }
        .btn-otp {
            background: #0284c7;
            color: #fff;
            border: none;
            padding: 0 10px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-pay-confirm {
            width: 100%;
            background: #059669;
            color: #fff;
            border: none;
            padding: 13px;
            border-radius: 12px;
            font-size: 13.5px;
            font-weight: 900;
            cursor: pointer;
        }

        /* اعلان شناور */
        .toast {
            position: fixed;
            bottom: 18px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            opacity: 0;
            z-index: 80;
            background: #0f172a;
            color: #fff;
            padding: 10px 18px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            transition: all 0.25s ease;
            pointer-events: none;
            white-space: nowrap;
            max-width: 92vw;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        footer {
            margin-top: 30px;
            border-top: 1px solid var(--border-color);
            background: #ffffff;
            padding: 16px 12px;
            text-align: center;
            font-size: 11.5px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <!-- نوار تبلیغاتی بالا -->
    <div id="topPromoBanner" class="promo-banner">
        <div class="promo-inner">
            <span>🚀 هاست ابری ویژه برنامه‌نویسان — کد تخفیف: <span class="promo-code font-mono">SAMAN50</span></span>
            <div style="display:flex;align-items:center;gap:6px;">
                <button onclick="copyToClipboard('SAMAN50', 'کد تخفیف SAMAN50 کپی شد!')" class="btn-promo-copy">کپی کد</button>
                <button onclick="document.getElementById('topPromoBanner').remove()" style="background:none;border:none;color:#fff;cursor:pointer;font-size:15px;">✕</button>
            </div>
        </div>
    </div>

    <!-- هدر اصلی -->
    <header>
        <div class="container">
            <div class="header-top">
                <div onclick="resetFilters()" class="brand">
                    <div class="brand-logo">&lt;/&gt;</div>
                    <div>
                        <div class="brand-title">
                            <span>کدمارکت</span>
                            <span class="pro-tag">PRO</span>
                        </div>
                    </div>
                </div>

                <div class="header-actions">
                    <button onclick="openTransactionsModal()" class="btn-header">
                        <span>رسیدها</span>
                        <span id="txCountBadge" class="badge-count" style="background:#2563eb;">0</span>
                    </button>
                    <button onclick="openNovinConfigModal()" class="btn-header" style="border-color:#c084fc;background:#faf5ff;color:#6b21a8;">
                        <span>⚙️ تنظیمات درگاه نوین</span>
                    </button>
                    <button onclick="setFilterType('owned')" class="btn-header">
                        <span>کدهای من</span>
                        <span id="ownedCounter" class="badge-count">10</span>
                    </button>
                </div>
            </div>

            <div class="search-box">
                <input type="text" id="searchInput" oninput="handleSearch(this.value)" class="search-input"
                    placeholder="جستجو بین ۱۲۰ سورس کد (درگاه سامان، React، پایتون...)">
                <button id="clearSearchBtn" onclick="clearSearch()" class="clear-btn hidden">✕</button>
            </div>
        </div>
    </header>

    <!-- بخش Hero و کارت بانکی سامان ایران -->
    <section class="hero-section">
        <div class="container hero-grid">
            <div class="hero-box">
                <span class="hero-pill">✨ ۱۰ سورس کد رایگان + ۱۱۰ پروژه تجاری</span>
                <h1 class="hero-title">توسعه سریع‌تر پروژه‌ها با کدهای آماده</h1>
                <p class="hero-desc">
