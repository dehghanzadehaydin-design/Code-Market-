                desc: "اسکریپت کامل ثبت تراکنش، بررسی شماره پیگیری و جلوگیری از رسید تکراری.",
                code: `class SamanBankGateway:\n    MERCHANT_CARD = "6219-8618-5400-1483"\n    BANK_NAME = "بانک سامان ایران"\n\n    def verify_payment(self, ref_code: str, amount: int):\n        return {"status": "SUCCESS", "card": self.MERCHANT_CARD, "ref": ref_code}`
            },
            {
                title: "کامپوننت کارت بانکی تعاملی با React",
                lang: "React",
                price: 110000,
                desc: "کارت بانکی هوشمند با تشخیص خودکار نام بانک از روی ۶ رقم اول شماره کارت.",
                code: `export function SmartBankCard({ cardNumber }) {\n  return <div className="saman-card">{cardNumber} - بانک سامان ایران</div>;\n}`
            },
            {
                title: "سیستم سبد خرید و محاسبه تخفیف پلکانی JavaScript",
                lang: "JavaScript",
                price: 75000,
                desc: "مدیریت کامل سبد خرید، اعمال کد تخفیف و محاسبه مبلغ نهایی پرداخت.",
                code: `class ShoppingCartEngine {\n  constructor() { this.items = []; }\n  getTotal() { return this.items.reduce((s, i) => s + i.price, 0); }\n}`
            },
            {
                title: "پنل ادمین مدیریت تراکنش‌ها و نمودار درآمد Tailwind",
                lang: "Tailwind",
                price: 130000,
                desc: "قالب کامل داشبورد مدیریت فروش و گزارش‌گیری تراکنش‌های بانک سامان.",
                code: `<div class="bg-white rounded-2xl p-6 shadow">گزارش واریزی‌های بانک سامان</div>`
            },
            {
                title: "فرم پرداخت واکنش‌گرا با اعتبارسنجی لحظه‌ای HTML/CSS",
                lang: "HTML/CSS",
                price: 85000,
                desc: "طراحی تمیز و استاندارد فرم پرداخت اینترنتی با نمایش شماره کارت پذیرنده.",
                code: `<div class="pay-box">پرداخت امن به کارت 6219-8618-5400-1483</div>`
            }
        ];

        const allSnippets = [...freeCodes];
        for (let i = 11; i <= 120; i++) {
            const tpl = commercialTemplates[(i - 11) % commercialTemplates.length];
            const ver = Math.floor((i - 11) / commercialTemplates.length) + 1;
            allSnippets.push({
                id: i,
                title: `${tpl.title} — نسخه تجاری ${ver}.0`,
                lang: tpl.lang,
                price: tpl.price + ((i % 5) * 15000),
                isFree: false,
                downloads: 240 + ((i * 37) % 3100),
                desc: tpl.desc,
                code: `// لایسنس تجاری اختصاصی #${i} — کدمارکت پرو\n${tpl.code}`
            });
        }

        let state = {
            purchasedIds: JSON.parse(localStorage.getItem('cm_v4_purchased') || '[]'),
            transactions: JSON.parse(localStorage.getItem('cm_v4_transactions') || '[]'),
            novinConfig: JSON.parse(localStorage.getItem('cm_v4_novin') || '{"merchantName":"آیدین دهقان‌زاده - کدمارکت پرو","terminalId":"","gatewayUrl":"https://pna.co.ir"}'),
            filterType: 'all',
            selectedLang: 'همه',
            searchQuery: '',
            visibleCount: 24
        };

        function persistState() {
            localStorage.setItem('cm_v4_purchased', JSON.stringify(state.purchasedIds));
            localStorage.setItem('cm_v4_transactions', JSON.stringify(state.transactions));
            localStorage.setItem('cm_v4_novin', JSON.stringify(state.novinConfig));
            updateBadges();
        }

        function updateBadges() {
            document.getElementById('ownedCounter').textContent = 10 + state.purchasedIds.length;
            document.getElementById('txCountBadge').textContent = state.transactions.length;
        }

        function init() {
            updateBadges();
            renderLanguageBar();
            renderGrid();
        }

        function renderLanguageBar() {
            const bar = document.getElementById('langFilterBar');
            bar.innerHTML = languages.map(lang => `
                <button onclick="selectLang('${lang}')" class="lang-btn ${state.selectedLang === lang ? 'active' : ''}">
                    ${lang}
                </button>
            `).join('');
        }

        function getFilteredList() {
            return allSnippets.filter(item => {
                const isUnlocked = item.isFree || state.purchasedIds.includes(item.id);
                if (state.filterType === 'free' && !item.isFree) return false;
                if (state.filterType === 'paid' && item.isFree) return false;
                if (state.filterType === 'owned' && !isUnlocked) return false;
                if (state.selectedLang !== 'همه' && item.lang !== state.selectedLang) return false;

                if (state.searchQuery.trim() !== '') {
                    const q = state.searchQuery.trim().toLowerCase();
                    if (!item.title.toLowerCase().includes(q) && !item.desc.toLowerCase().includes(q) && !item.lang.toLowerCase().includes(q)) {
                        return false;
                    }
                }
                return true;
            });
        }

        function renderGrid() {
            const grid = document.getElementById('snippetsGrid');
            const emptyBox = document.getElementById('emptyStateBox');
            const loadMoreSec = document.getElementById('loadMoreSection');
            const countLabel = document.getElementById('resultsCountLabel');

            const filtered = getFilteredList();
            const shown = filtered.slice(0, state.visibleCount);

            countLabel.textContent = `نمایش ${shown.length} از ${filtered.length} سورس کد`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyBox.classList.remove('hidden');
                loadMoreSec.classList.add('hidden');
            } else {
                emptyBox.classList.add('hidden');
                loadMoreSec.classList.toggle('hidden', shown.length >= filtered.length);

                grid.innerHTML = shown.map(item => {
                    const isUnlocked = item.isFree || state.purchasedIds.includes(item.id);
                    const previewLines = escapeHtml(item.code.split('\n').slice(0, 4).join('\n'));

                    return `
                        <div onclick="openDetailModal(${item.id})" class="code-card">
                            <div>
                                <div class="card-top-row">
                                    <span class="lang-pill">${item.lang}</span>
                                    ${item.isFree
                                        ? `<span class="price-pill-free">رایگان</span>`
                                        : isUnlocked
                                            ? `<span class="price-pill-owned">✓ خریداری شده</span>`
                                            : `<span class="price-pill-paid">${item.price.toLocaleString('fa-IR')} تومان</span>`
                                    }
                                </div>

                                <h3 class="card-title">${item.title}</h3>
                                <p class="card-desc">${item.desc}</p>

                                <div class="code-preview-box">
                                    <pre class="font-mono ${!isUnlocked ? 'blurred' : ''}" dir="ltr">${previewLines}</pre>
                                    ${!isUnlocked ? `
                                        <div class="lock-overlay">
                                            <span class="lock-badge">🔒 قفل — نیازمند واریز به بانک سامان</span>
                                        </div>
                                    ` : ''}
                                </div>
                            </div>

                            <div class="card-footer" onclick="event.stopPropagation()">
                                <span class="dl-count">⬇ ${item.downloads.toLocaleString('fa-IR')} دانلود</span>
                                ${isUnlocked ? `
                                    <button onclick="openDetailModal(${item.id})" class="btn-action-free">مشاهده و دانلود</button>
                                ` : `
                                    <button onclick="openSamanGateway(${item.id})" class="btn-action-buy">خرید اینترنتی</button>
                                `}
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        function setFilterType(type) {
            state.filterType = type;
            state.visibleCount = 24;
            document.querySelectorAll('.chip-btn').forEach(b => b.classList.remove('active'));
            const active = document.getElementById(`ft-${type}`);
            if (active) active.classList.add('active');
            renderGrid();
        }

        function selectLang(lang) {
            state.selectedLang = lang;
            state.visibleCount = 24;
            renderLanguageBar();
            renderGrid();
        }

        function handleSearch(val) {
            state.searchQuery = val;
            document.getElementById('clearSearchBtn').classList.toggle('hidden', val.length === 0);
            renderGrid();
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            handleSearch('');
        }

        function resetFilters() {
            state.filterType = 'all';
            state.selectedLang = 'همه';
            state.visibleCount = 24;
            clearSearch();
            setFilterType('all');
            renderLanguageBar();
        }

        function loadMoreItems() {
            state.visibleCount += 24;
            renderGrid();
        }

        function openDetailModal(id) {
            const item = allSnippets.find(s => s.id === id);
            if (!item) return;

            const isUnlocked = item.isFree || state.purchasedIds.includes(item.id);
            document.getElementById('detailLangBadge').textContent = item.lang;
            document.getElementById('detailTitle').textContent = item.title;

            const container = document.getElementById('detailModalContent');

            if (isUnlocked) {
                container.innerHTML = `
                    <p style="font-size:12.5px;color:#475569;margin-bottom:12px;">${item.desc}</p>
                    ${item.previewHtml ? `<div style="margin-bottom:12px;">${item.previewHtml}</div>` : ''}
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;background:#f8fafc;border:1px solid #e2e8f0;padding:10px;border-radius:12px;margin-bottom:12px;">
                        <span style="color:#059669;font-size:11.5px;font-weight:800;">✓ دسترسی کامل سورس کد فعال است</span>
                        <div style="display:flex;gap:6px;">
                            <button onclick="copyToClipboard(allSnippets.find(x=>x.id===${item.id}).code, 'سورس کد کپی شد!')" class="chip-btn">کپی سورس</button>
                            <button onclick="downloadCodeFile(${item.id})" class="btn-action-free">دانلود فایل</button>
                        </div>
                    </div>
                    <div style="background:#0f172a;border-radius:12px;padding:12px;overflow-x:auto;">
                        <pre class="font-mono" style="font-size:11.5px;color:#e2e8f0;margin:0;" dir="ltr">${escapeHtml(item.code)}</pre>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <p style="font-size:12.5px;color:#475569;margin-bottom:12px;">${item.desc}</p>
                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:20px;text-align:center;">
                        <div style="font-size:26px;margin-bottom:6px;">🔒</div>
                        <h4 style="font-size:15px;font-weight:800;margin-bottom:6px;">این سورس کد ویژه و پولی است</h4>
                        <p style="font-size:12px;color:#475569;margin-bottom:14px;">
                            برای باز کردن قفل این سورس کد، مبلغ <strong style="color:#d97706;">${item.price.toLocaleString('fa-IR')} تومان</strong> را به شماره کارت <strong class="font-mono" style="color:#0284c7;" dir="ltr">6219-8618-5400-1483</strong> (بانک سامان ایران) واریز کنید.
                        </p>
                        <button onclick="closeDetailModal(); openSamanGateway(${item.id})" class="btn-action-buy" style="padding:10px 18px;font-size:12.5px;">
                            انتقال به درگاه بانک سامان (${item.price.toLocaleString('fa-IR')} تومان)
                        </button>
                    </div>
                `;
            }

            document.getElementById('codeDetailModal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('codeDetailModal').classList.add('hidden');
        }

        function downloadCodeFile(id) {
            const item = allSnippets.find(s => s.id === id);
            if (!item) return;

            const extMap = { 'Python': 'py', 'JavaScript': 'js', 'React': 'jsx', 'HTML/CSS': 'html', 'Tailwind': 'html' };
            const ext = extMap[item.lang] || 'txt';
            const blob = new Blob([item.code], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);

            const a = document.createElement('a');
            a.href = url;
            a.download = `CodeMarketPro_${item.id}.${ext}`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            showToast(`فایل CodeMarketPro_${item.id}.${ext} دانلود شد!`);
        }

        let activeGatewayItem = null;
        let gatewayTimerInterval = null;

        function openSamanGateway(snippetId) {
            const item = allSnippets.find(s => s.id === snippetId);
            if (!item || item.isFree) return;

            activeGatewayItem = item;
            document.getElementById('gwProductTitle').textContent = item.title;
            document.getElementById('gwAmountDisplay').textContent = item.price.toLocaleString('fa-IR') + ' تومان';
            document.getElementById('samanPaymentForm').reset();

            clearInterval(gatewayTimerInterval);
            let secondsLeft = 600;
            const timerEl = document.getElementById('gatewayTimer');
            timerEl.textContent = '10:00';
            gatewayTimerInterval = setInterval(() => {
                secondsLeft--;
                const m = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
                const s = String(secondsLeft % 60).padStart(2, '0');
                timerEl.textContent = `${m}:${s}`;
                if (secondsLeft <= 0) {
                    clearInterval(gatewayTimerInterval);
                    closeSamanGateway();
                    showToast('مهلت زمان درگاه پرداخت به پایان رسید.');
                }
            }, 1000);

            document.getElementById('samanGatewayModal').classList.remove('hidden');
        }

        function closeSamanGateway() {
            clearInterval(gatewayTimerInterval);
            activeGatewayItem = null;
            document.getElementById('samanGatewayModal').classList.add('hidden');
        }

        function formatCardNumberInput(input) {
            const digits = input.value.replace(/\D/g, '').slice(0, 16);
            input.value = digits.replace(/(\d{4})(?=\d)/g, '$1-');
        }

        function sendMockOtp() {
            const cardVal = document.getElementById('payerCardNumber').value.replace(/\D/g, '');
            if (cardVal.length < 16) {
                showToast('لطفاً ابتدا شماره کارت ۱۶ رقمی خود را وارد کنید.');
                return;
            }
            const generatedOtp = Math.floor(100000 + Math.random() * 900000);
            document.getElementById('dynamicOtpInput').value = generatedOtp;
            showToast(`رمز پویای شتابی (${generatedOtp}) جایگذاری شد!`);
        }

        function submitRealSamanPayment(e) {
            e.preventDefault();
            if (!activeGatewayItem) return;

            const payerCard = document.getElementById('payerCardNumber').value.replace(/\D/g, '');
            const refCode = document.getElementById('bankRefCode').value.trim();

            if (payerCard.length !== 16) {
                showToast('شماره کارت پرداخت‌کننده باید ۱۶ رقم باشد.');
                return;
            }
            if (refCode.length < 6) {
                showToast('شماره پیگیری تراکنش باید حداقل ۶ رقم باشد.');
                return;
            }
            if (state.transactions.some(t => t.refCode === refCode)) {
                showToast('این شماره پیگیری قبلاً ثبت شده است!');
                return;
            }

            const btn = document.getElementById('confirmGwBtn');
            btn.disabled = true;
            btn.textContent = 'در حال تایید تراکنش با بانک سامان ایران...';

            setTimeout(() => {
                const boughtItem = activeGatewayItem;
                const receipt = {
                    receiptId: 'SMN-' + Math.floor(100000 + Math.random() * 900000),
                    refCode,
                    payerCard: payerCard.slice(0, 4) + '-****-****-' + payerCard.slice(-4),
                    destinationCard: DESTINATION_CARD,
                    bankName: DESTINATION_BANK,
                    itemTitle: boughtItem.title,
                    amount: boughtItem.price,
                    date: new Date().toLocaleString('fa-IR')
                };

                state.transactions.unshift(receipt);
                if (!state.purchasedIds.includes(boughtItem.id)) {
                    state.purchasedIds.push(boughtItem.id);
                }
                persistState();
                renderGrid();

                btn.disabled = false;
                btn.textContent = 'تایید پرداخت و دریافت آنی کد';

                closeSamanGateway();
                showToast(`تراکنش موفق! کد پیگیری: ${receipt.receiptId}`);
                openDetailModal(boughtItem.id);
            }, 800);
        }

        function openTransactionsModal() {
            const list = document.getElementById('transactionsListContainer');
            if (state.transactions.length === 0) {
                list.innerHTML = `<div style="text-align:center;padding:28px 12px;color:#64748b;font-size:12.5px;">هنوز تراکنشی ثبت نشده است.</div>`;
            } else {
                list.innerHTML = state.transactions.map(tx => `
                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;padding:12px;margin-bottom:8px;font-size:11.5px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:5px;">
                            <span style="color:#059669;font-weight:800;">✓ موفق (${tx.bankName})</span>
                            <span class="font-mono" style="color:#64748b;">${tx.receiptId}</span>
                        </div>
                        <div style="font-weight:800;margin-bottom:5px;color:#0f172a;">${tx.itemTitle}</div>
                        <div style="display:flex;justify-content:space-between;color:#475569;border-top:1px solid #e2e8f0;padding-top:5px;">
                            <span>مقصد: <strong class="font-mono" dir="ltr">${tx.destinationCard}</strong></span>
                            <strong style="color:#d97706;">${tx.amount.toLocaleString('fa-IR')} تومان</strong>
                        </div>
                    </div>
                `).join('');
            }
            document.getElementById('transactionsModal').classList.remove('hidden');
        }

        function closeTransactionsModal() {
            document.getElementById('transactionsModal').classList.add('hidden');
        }

        function openNovinConfigModal() {
            document.getElementById('novinMerchantName').value = state.novinConfig.merchantName || 'آیدین دهقان‌زاده - کدمارکت پرو';
            document.getElementById('novinTerminalId').value = state.novinConfig.terminalId || '';
            document.getElementById('novinGatewayUrl').value = state.novinConfig.gatewayUrl || 'https://pna.co.ir';
            document.getElementById('novinConfigModal').classList.remove('hidden');
        }

        function closeNovinConfigModal() {
            document.getElementById('novinConfigModal').classList.add('hidden');
        }

        function saveNovinConfig(e) {
            e.preventDefault();
            state.novinConfig = {
                merchantName: document.getElementById('novinMerchantName').value.trim(),
                terminalId: document.getElementById('novinTerminalId').value.trim(),
                gatewayUrl: document.getElementById('novinGatewayUrl').value.trim() || 'https://pna.co.ir'
            };
            persistState();
            closeNovinConfigModal();
            showToast('تنظیمات درگاه پرداخت نوین آرین با موفقیت ذخیره شد!');
        }

        function redirectToPardakhtNovin() {
            if (!activeGatewayItem) return;
            const targetUrl = state.novinConfig.gatewayUrl || 'https://pna.co.ir';
            showToast('در حال باز کردن صفحه پرداخت نوین آرین...');
            window.open(targetUrl, '_blank', 'noopener,noreferrer');
        }

        function copyToClipboard(text, message) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showToast(message);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        let toastTimer;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').textContent = msg;
            toast.classList.add('show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 3000);
        }

        window.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
